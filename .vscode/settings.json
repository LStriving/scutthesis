{
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "python-envs.pythonProjects": [],
    "latex-workshop.latex.outDir": "%DIR%/build",
    "latex-workshop.latex.tools": [
        {
            "name": "dedup-bib",
            "command": "python",
            "args": [
                "dedup_bib.py",
                "--input",
                "%DOCFILE%.bib"
            ]
        },
        {
            "name": "xelatex-outdir",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-shell-escape",
                "-output-directory=build",
                "%DOC%"
            ]
        },
        {
            "name": "biber-outdir",
            "command": "biber",
            "args": [
                "--output-directory=build",
                "%DOCFILE%"
            ]
        },
        {
            "name": "copy-pdf-back",
            "command": "cmd",
            "args": [
                "/c",
                "copy /Y build\\%DOCFILE%.pdf %DOCFILE%.pdf >nul"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "xelatex -> biber -> xelatex*2 (outdir)",
            "tools": [
                "dedup-bib",
                "xelatex-outdir",
                "biber-outdir",
                "xelatex-outdir",
                "xelatex-outdir",
                "copy-pdf-back"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "lastUsed",
    "latex-workshop.latex.autoBuild.run": "onSave"
}